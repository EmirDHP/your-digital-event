{
  "id": "eclipse",
  "name": "Eclipse",
  "themeColor": "#0B0B0B",
  "css": "theme.css",
  "fonts": [
    {
      "rel": "preconnect",
      "href": "https://fonts.googleapis.com"
    },
    {
      "rel": "preconnect",
      "href": "https://fonts.gstatic.com",
      "crossorigin": true
    },
    {
      "rel": "stylesheet",
      "href": "https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@300;400;600;700&display=swap"
    }
  ],
  "runtimeOptions": {
    "preserveEmptyHeroState": true,
    "paletteVariables": {
      "background": "--bg",
      "foreground": "--fg",
      "muted": "--muted",
      "accent": "--gold",
      "card": "--card",
      "stroke": "--stroke",
      "focus": "--ring",
      "accentSoftBorder": "--accent-soft-border",
      "accentSoftBackground": "--accent-soft-bg",
      "accentSoftText": "--accent-soft-text",
      "surfaceElevated": "--surface-elevated",
      "surfaceSubtle": "--surface-subtle"
    }
  }
}

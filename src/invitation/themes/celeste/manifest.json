{
  "id": "celeste",
  "name": "Celeste",
  "themeColor": "#F1F3EF",
  "css": "theme.css",
  "fonts": [
    {
      "rel": "preconnect",
      "href": "https://fonts.googleapis.com"
    },
    {
      "rel": "preconnect",
      "href": "https://fonts.gstatic.com",
      "crossorigin": true
    },
    {
      "rel": "stylesheet",
      "href": "https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
    }
  ],
  "runtimeOptions": {
    "paletteVariables": {
      "canvas": "--celeste-canvas",
      "paper": "--celeste-paper",
      "surface": "--celeste-pearl",
      "accent": "--celeste-blue",
      "accentSoft": "--celeste-blue-soft",
      "petal": "--celeste-rose",
      "botanical": "--celeste-sage",
      "line": "--celeste-sand",
      "angelLeft": "--celeste-angel-blue",
      "angelRight": "--celeste-angel-champagne",
      "daisyLeft": "--celeste-daisy-left",
      "daisyRight": "--celeste-daisy-right",
      "ink": "--celeste-ink",
      "muted": "--celeste-muted",
      "focus": "--celeste-focus",
      "navAccent": "--celeste-nav-accent",
      "softLine": "--celeste-soft-line",
      "dot": "--celeste-dot",
      "action": "--celeste-button-bg",
      "actionHover": "--celeste-button-hover",
      "actionText": "--celeste-button-text",
      "heroStart": "--celeste-hero-start",
      "heroEnd": "--celeste-hero-end",
      "gateStart": "--celeste-gate-start",
      "gateEnd": "--celeste-gate-end",
      "botanicalLine": "--celeste-botanical-line",
      "heroBotanicalLine": "--celeste-hero-botanical-line"
    },
    "revealProfile": {
      "baseSelectors": [
        ".hero-content",
        ".message",
        "#personas",
        "#detalles",
        "#rsvp",
        ".footer"
      ],
      "itemSelectors": [
        ".countdown .cd-item",
        "#personas .people-group",
        "#detalles .card"
      ]
    }
  }
}
